; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Basketball"
run/main_scene="res://scenes/light.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://assets/ball.svg"

[autoload]

Datas="*res://scripts/datas.gd"
Events="*res://scripts/events.gd"

[display]

window/size/viewport_width=576
window/size/viewport_height=1024
window/size/always_on_top=true
window/size/window_width_override=288
window/size/window_height_override=512
window/stretch/mode="canvas_items"
window/handheld/orientation=1
window/snap/snap_2d_transforms_to_pixel=true
window/snap/snap_2d_vertices_to_pixel=true

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_sfxr/plugin.cfg")

[layer_names]

2d_physics/layer_1="floor"
2d_physics/layer_2="basket"
2d_physics/layer_3="ball"

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
